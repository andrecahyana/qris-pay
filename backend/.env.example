# Backend environment example

# Postgres connection
DATABASE_URL=postgres://postgres:password@db:5432/qris

# JWT secret (use strong random value)
JWT_SECRET=change_this_secret

# Server port
BACKEND_PORT=4000

# Webhook secret for HMAC verification (use strong random value)
WEBHOOK_SECRET=change_this_webhook_secret

# CORS allowed origins (comma-separated) or wildcard '*'
ALLOWED_ORIGINS=*

# Rate limiter settings (ms and max requests)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=20
